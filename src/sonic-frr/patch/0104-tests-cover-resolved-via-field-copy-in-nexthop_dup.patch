From d9282f3f7b2c26dd7b1e033b65ab01da8f337ed6 Mon Sep 17 00:00:00 2001
From: Eddie Ruan <eddie.ruan@alibaba-inc.com>
Date: Thu, 30 Jul 2026 13:24:08 -0700
Subject: [PATCH 5/5] tests: cover resolved-via field copy in nexthop_dup

---
 tests/lib/test_nexthop.c | 31 +++++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/tests/lib/test_nexthop.c b/tests/lib/test_nexthop.c
index 99a1243a6c..d3be0f9f27 100644
--- a/tests/lib/test_nexthop.c
+++ b/tests/lib/test_nexthop.c
@@ -180,10 +180,41 @@ static void test_run_first(void)
 	nexthop_free(nh2);
 }
 
+static void test_resolved_via_copy(void)
+{
+	struct nexthop *nh, *copy;
+	struct in_addr via;
+
+	nh = nexthop_from_ifindex(11, 0);
+	nh->resolved_via = 4242;
+	inet_pton(AF_INET, "10.0.0.1", &via);
+	nh->resolved_addr.ipa_type = IPADDR_V4;
+	nh->resolved_addr.ipaddr_v4 = via;
+	nh->resolved_len = 32;
+
+	copy = nexthop_dup(nh, NULL);
+	assert(copy->resolved_via == 4242);
+	assert(copy->resolved_len == 32);
+	assert(copy->resolved_addr.ipaddr_v4.s_addr == via.s_addr);
+	nexthop_free(copy);
+
+	/* unset fields must copy as zero */
+	nh->resolved_via = 0;
+	nh->resolved_len = 0;
+	memset(&nh->resolved_addr, 0, sizeof(nh->resolved_addr));
+	copy = nexthop_dup(nh, NULL);
+	assert(copy->resolved_via == 0);
+	assert(copy->resolved_len == 0);
+	nexthop_free(copy);
+
+	nexthop_free(nh);
+}
+
 int main(int argc, char **argv)
 {
 	if (argc >= 2 && !strcmp("-v", argv[1]))
 		verbose = true;
 	test_run_first();
+	test_resolved_via_copy();
 	printf("Simple test passed.\n");
 }
